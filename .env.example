# JobLens server — environment variables (names only; fill in real values locally / in Vercel)
# See JOBLENS-FULL-AUDIT.md §7 for where each variable is read.
# Never commit a real .env file — .env is gitignored.

# Port the Express server listens on (default: 5000)
PORT=

# MongoDB Atlas connection string (no fallback — required)
MONGODB=

# Gmail account used to send password-reset emails
EMAIL_USER=
# Gmail app password for EMAIL_USER (not your normal Gmail password)
EMAIL_PASS=

# Set to "production" on Vercel (controls cookie secure/sameSite flags)
NODE_ENV=

# Secret used to sign login/session JWTs and password-reset tokens
JWT_SECRET=

# Public client URL used as the base of password-reset links
# (default when unset: https://joblenss.netlify.app)
CLIENT_URL=

# Base URL of the deployed ML service (e.g. https://ml-service-mauve.vercel.app); unset = /api/ml/predict returns 503
ML_SERVICE_URL=

# Timeout in ms for the ML service proxy call (default: 30000)
ML_TIMEOUT_MS=
